# ==============================================================================
# Environment Configuration (.env.example)
# Copy to .env for local development or testing.
# Never commit real credentials or production secrets.
# ==============================================================================

# Application & Environment
APP_NAME="Resume Project Review Platform"
APP_ENV=development
DEBUG=true

# Database & Cache
DATABASE_URL=postgresql+psycopg://app_user:app_password@localhost:5432/resume_review
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_DIR=/tmp/resume_storage

# Authentication & Sessions
# Generate secure keys in production via: openssl rand -hex 32
SECRET_KEY=dev-insecure-secret-key-change-in-prod
ADMIN_PASSWORD=change-this-admin-password
SESSION_TTL_SECONDS=86400
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# CORS & Allowed Origins (JSON array or comma-separated)
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# GitHub API Integration (Optional for local testing; uses unauthenticated public API or test adapters)
GITHUB_TOKEN=replace-with-your-github-token
GITHUB_API_BASE=https://api.github.com
GITHUB_API_TIMEOUT_SECONDS=10.0
GITHUB_CACHE_TTL_SECONDS=3600

# Optional Gemini API Integration
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Retention Policy
RETENTION_DAYS=7

# Test Adapters & Sandbox Isolation (STRICTLY FORBIDDEN IN PRODUCTION: app crashes if APP_ENV=production)
ALLOW_TEST_ADAPTERS=false
